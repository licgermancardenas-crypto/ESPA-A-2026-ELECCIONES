	partition Escenarios = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "escenarios.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Seleccion = Table.SelectColumns(Encabezados, {"provincia_id", "escenario", "orden", "bloque", "candidatura", "voto", "escanos", "color"}),
				    Tipos = Table.TransformColumnTypes(Seleccion, {{"provincia_id", type text}, {"escenario", type text}, {"orden", Int64.Type}, {"bloque", type text}, {"candidatura", type text}, {"voto", type number}, {"escanos", type number}, {"color", type text}}, "en-US")
				in
				    Tipos

