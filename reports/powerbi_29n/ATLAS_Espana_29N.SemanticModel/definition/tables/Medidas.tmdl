	measure 'Mapa nacional' =
			VAR idm = SELECTEDVALUE('Métrica del mapa'[id], 1)
			VAR sel = VALUES(Provincias[provincia_id])
			VAR todo = COUNTROWS(sel) = COUNTROWS(ALL(Provincias))
			VAR t = ADDCOLUMNS(ALL(Provincias), "@c", IF(todo || Provincias[provincia_id] IN sel, SWITCH(idm, 1, Provincias[c_fav], 2, Provincias[c_prob], 3, Provincias[c_comp], 4, Provincias[c_cambio], 5, Provincias[c_g2023], 6, Provincias[c_cal], 7, Provincias[c_v_pp], 8, Provincias[c_v_psoe], 9, Provincias[c_v_vox], Provincias[c_v_fa]), "#E4DFEE"))
			VAR grupos = CONCATENATEX(DISTINCT(SELECTCOLUMNS(t, "@c", [@c])), VAR col = [@c] RETURN "<g fill='" & col & "'>" & CONCATENATEX(FILTER(t, [@c] = col), "<path d='" & Provincias[path] & "'/>", "") & "</g>", "")
			VAR titulo = "<text x='1278' y='60' font-family='Segoe UI Semibold' font-size='24' fill='#1D1631'>" & SELECTEDVALUE('Métrica del mapa'[Métrica], "Favorito 2026") & "</text>"
			VAR ley = CONCATENATEX(FILTER(ALL(Leyendas), Leyendas[metrica_id] = idm), "<rect x='1278' y='" & (84 + Leyendas[orden] * 30) & "' width='20' height='15' rx='3' fill='" & Leyendas[color] & "' stroke='#B9AEDB' stroke-width='0.6'/><text x='1306' y='" & (97 + Leyendas[orden] * 30) & "' font-family='Segoe UI' font-size='17' fill='#1D1631'>" & Leyendas[etiqueta] & "</text>", "", Leyendas[orden], ASC)
			VAR cuerpo = "<g stroke='#FFFFFF' stroke-width='1.6' stroke-linejoin='round' transform='scale(0.5)'>" & grupos & "</g>" & IF(todo, "", "<g fill='none' stroke='#1D1631' stroke-width='4' transform='scale(0.5)'>" & CONCATENATEX(FILTER(ALL(Provincias), Provincias[provincia_id] IN sel), "<path d='" & Provincias[path] & "'/>", "") & "</g>") & "<rect x='6' y='691' width='377' height='203' rx='10' fill='none' stroke='#B9AEDB' stroke-dasharray='6 5'/><text x='18' y='713' font-family='Segoe UI' font-size='15' fill='#6B6480'>Canarias</text>" & titulo & ley
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & 1648 & " " & 900 & "'>" & cuerpo & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Mapas
		lineageTag: ac1a7b02-1633-45df-8d45-b9524c1b4521
		dataCategory: ImageUrl

	measure 'Mapa provincial' =
			VAR pid = SELECTEDVALUE(Provincias[provincia_id], "28")
			VAR pw = CALCULATE(MAX(Provincias[ancho]), ALL(Provincias), Provincias[provincia_id] = pid)
			VAR ph = CALCULATE(MAX(Provincias[alto]), ALL(Provincias), Provincias[provincia_id] = pid)
			VAR borde = CALCULATE(MAX(Provincias[borde_prov]), ALL(Provincias), Provincias[provincia_id] = pid)
			VAR t = ADDCOLUMNS(FILTER(ALL(Municipios), Municipios[provincia_id] = pid && Municipios[path_prov] <> ""), "@c", Municipios[color])
			VAR grupos = CONCATENATEX(DISTINCT(SELECTCOLUMNS(t, "@c", [@c])), VAR col = [@c] RETURN "<g fill='" & col & "'>" & CONCATENATEX(FILTER(t, [@c] = col), "<path d='" & Municipios[path_prov] & "'/>", "") & "</g>", "")
			VAR cuerpo = "<g stroke='#FFFFFF' stroke-width='0.8' stroke-linejoin='round' transform='scale(0.5)'>" & grupos & "</g>"
			    & "<g fill='none' stroke='#1D1631' stroke-width='3' transform='scale(0.5)'><path d='" & borde & "'/></g>"
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & pw & " " & ph & "'>" & cuerpo & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Mapas
		lineageTag: 32b5a8be-16f8-4811-b9c3-1900e484a6f2
		dataCategory: ImageUrl

	measure 'Leyenda del mapa' =
			VAR idm = SELECTEDVALUE('Métrica del mapa'[id], 1)
			VAR n = CALCULATE(COUNTROWS(Leyendas), ALL(Leyendas), Leyendas[metrica_id] = idm)
			VAR cuerpo = "<text x='4' y='18' font-family='Segoe UI Semibold' font-size='16' fill='#1D1631'>" & SELECTEDVALUE('Métrica del mapa'[Métrica], "Favorito 2026") & "</text>" & CONCATENATEX(FILTER(ALL(Leyendas), Leyendas[metrica_id] = idm), "<rect x='4' y='" & (32 + Leyendas[orden] * 26) & "' width='20' height='15' rx='3' fill='" & Leyendas[color] & "' stroke='#B9AEDB' stroke-width='0.6'/><text x='32' y='" & (45 + Leyendas[orden] * 26) & "' font-family='Segoe UI' font-size='15' fill='#1D1631'>" & Leyendas[etiqueta] & "</text>", "", Leyendas[orden], ASC)
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & 420 & " " & (44 + n * 26) & "'>" & cuerpo & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Mapas
		lineageTag: 16681aa2-fb0a-4f0e-aa62-650a521f6d45
		dataCategory: ImageUrl

	measure 'Mapa ubicación' =
			VAR pid = SELECTEDVALUE(Provincias[provincia_id], "28")
			VAR t = ADDCOLUMNS(ALL(Provincias), "@c", IF(Provincias[provincia_id] = pid, "#5B3F99", "#E4DFEE"))
			VAR grupos = CONCATENATEX(DISTINCT(SELECTCOLUMNS(t, "@c", [@c])), VAR col = [@c] RETURN "<g fill='" & col & "'>" & CONCATENATEX(FILTER(t, [@c] = col), "<path d='" & Provincias[path] & "'/>", "") & "</g>", "")
			VAR cuerpo = "<g stroke='#FFFFFF' stroke-width='1.6' transform='scale(0.5)'>" & grupos & "</g>" & "<rect x='6' y='691' width='377' height='203' rx='10' fill='none' stroke='#B9AEDB' stroke-dasharray='6 5'/><text x='18' y='713' font-family='Segoe UI' font-size='15' fill='#6B6480'>Canarias</text>"
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & 1268 & " " & 900 & "'>" & cuerpo & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Mapas
		lineageTag: 87546577-b7d9-4abc-9ab0-cfaafe5f7761
		dataCategory: ImageUrl

	measure 'Mapa 2015' =
			VAR t = ADDCOLUMNS(ALL(Provincias), "@c", Provincias[c_201512])
			VAR grupos = CONCATENATEX(DISTINCT(SELECTCOLUMNS(t, "@c", [@c])), VAR col = [@c] RETURN "<g fill='" & col & "'>" & CONCATENATEX(FILTER(t, [@c] = col), "<path d='" & Provincias[path] & "'/>", "") & "</g>", "")
			VAR cuerpo = "<g stroke='#FFFFFF' stroke-width='1.6' transform='scale(0.5)'>" & grupos & "</g>"
			    & "<text x='1248' y='70' text-anchor='end' font-family='Segoe UI Black' font-size='72' fill='#1D1631'>2015</text>"
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & 1268 & " " & 900 & "'>" & cuerpo & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Mapas
