	partition 'Escaños nacional' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "escanos_nacional.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Seleccion = Table.SelectColumns(Encabezados, {"bloque", "nombre", "media", "p10", "p50", "p90", "color"}),
				    Tipos = Table.TransformColumnTypes(Seleccion, {{"bloque", type text}, {"nombre", type text}, {"media", type number}, {"p10", type number}, {"p50", type number}, {"p90", type number}, {"color", type text}}, "en-US")
				in
				    Tipos

