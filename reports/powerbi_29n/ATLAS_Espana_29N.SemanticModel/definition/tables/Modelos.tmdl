table Modelos
	lineageTag: 7f826e87-6514-42eb-9e32-757225b19904

	column modelo
		dataType: string
		lineageTag: 2b85443e-b655-4049-9e5d-378e45b5a0b8
		summarizeBy: none
		sourceColumn: modelo

	column kl
		dataType: double
		formatString: 0.0000
		lineageTag: d3d2baf9-70de-41b5-b178-bcc77f40d495
		summarizeBy: none
		sourceColumn: kl

	column mae_pp
		dataType: double
		formatString: 0.00
		lineageTag: ad6a5fee-c516-4a8b-b9ed-2965c7348416
		summarizeBy: none
		sourceColumn: mae_pp

	column acierto_ganador
		dataType: double
		formatString: 0%
		lineageTag: 98032581-9123-45cb-b8bb-d3d79cb7481b
		summarizeBy: none
		sourceColumn: acierto_ganador

	column error_escanos
		dataType: double
		formatString: 0.0
		lineageTag: 56b9ddf0-df4d-4545-ae50-8d678ea34ccb
		summarizeBy: none
		sourceColumn: error_escanos

	column seleccionado
		dataType: int64
		formatString: 0
		lineageTag: 35c6a94d-b044-4a44-a17c-6cf8b49324f1
		summarizeBy: none
		sourceColumn: seleccionado

	partition Modelos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "modelos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Seleccion = Table.SelectColumns(Encabezados, {"modelo", "kl", "mae_pp", "acierto_ganador", "error_escanos", "seleccionado"}),
				    Tipos = Table.TransformColumnTypes(Seleccion, {{"modelo", type text}, {"kl", type number}, {"mae_pp", type number}, {"acierto_ganador", type number}, {"error_escanos", type number}, {"seleccionado", Int64.Type}}, "en-US")
				in
				    Tipos

