				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "provincias.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"geo_id", type text}, {"provincia_ine", type text}, {"nombre", type text}, {"ccaa_ine", type text}, {"pob_actual", Int64.Type}, {"pob_hace10", Int64.Type}, {"area_km2", type number}, {"pib_pc", type number}, {"pib_pc_anyo", Int64.Type}, {"n_municipios", Int64.Type}, {"path", type text}, {"cx", Int64.Type}, {"cy", Int64.Type}}, "en-US")
				in
				    Tipos

