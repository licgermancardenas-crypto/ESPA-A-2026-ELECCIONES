table Provincias

	column geo_id
		dataType: string
		summarizeBy: none
		sourceColumn: geo_id
		isHidden

	column provincia_ine
		dataType: string
		summarizeBy: none
		sourceColumn: provincia_ine
		isKey

	column nombre
		dataType: string
		summarizeBy: none
		sourceColumn: nombre
		sortByColumn: provincia_ine

	column ccaa_ine
		dataType: string
		summarizeBy: none
		sourceColumn: ccaa_ine
		isHidden

	column pob_actual
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: pob_actual
		isHidden

	column pob_hace10
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: pob_hace10
		isHidden

	column area_km2
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: area_km2

	column pib_pc
		dataType: double
		formatString: #,0 €
		summarizeBy: none
		sourceColumn: pib_pc

	column pib_pc_anyo
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: pib_pc_anyo

	column n_municipios
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: n_municipios

	column path
		dataType: string
		summarizeBy: none
		sourceColumn: path
		isHidden

	column cx
		dataType: int64
		summarizeBy: none
		sourceColumn: cx
		isHidden

	column cy
		dataType: int64
		summarizeBy: none
		sourceColumn: cy
		isHidden

	partition Provincias = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "provincias.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"geo_id", type text}, {"provincia_ine", type text}, {"nombre", type text}, {"ccaa_ine", type text}, {"pob_actual", Int64.Type}, {"pob_hace10", Int64.Type}, {"area_km2", type number}, {"pib_pc", type number}, {"pib_pc_anyo", Int64.Type}, {"n_municipios", Int64.Type}, {"path", type text}, {"cx", Int64.Type}, {"cy", Int64.Type}}, "en-US")
				in
				    Tipos

