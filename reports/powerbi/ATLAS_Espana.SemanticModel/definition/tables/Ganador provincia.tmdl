	partition 'Ganador provincia' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "nac_ganadores_prov.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"election_id", type text}, {"geo_id", type text}, {"ganador", type text}, {"familia_ganador", type text}, {"cuota_ganador", type number}, {"margen", type number}, {"segundo", type text}}, "en-US")
				in
				    Tipos

