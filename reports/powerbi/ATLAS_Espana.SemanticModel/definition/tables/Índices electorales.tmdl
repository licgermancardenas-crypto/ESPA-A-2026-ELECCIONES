table 'Índices electorales'
	isHidden

	column election_id
		dataType: string
		summarizeBy: none
		sourceColumn: election_id

	column geo_level
		dataType: string
		summarizeBy: none
		sourceColumn: geo_level

	column geo_id
		dataType: string
		summarizeBy: none
		sourceColumn: geo_id

	column enep
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: enep

	column enpp
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: enpp

	column gallagher
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: gallagher

	column competitividad
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: competitividad

	column volatilidad_pedersen
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: volatilidad_pedersen

	partition 'Índices electorales' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "nac_indices.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"election_id", type text}, {"geo_level", type text}, {"geo_id", type text}, {"enep", type number}, {"enpp", type number}, {"gallagher", type number}, {"competitividad", type number}, {"volatilidad_pedersen", type number}}, "en-US")
				in
				    Tipos

