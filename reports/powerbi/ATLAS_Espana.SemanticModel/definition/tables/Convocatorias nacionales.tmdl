	partition 'Convocatorias nacionales' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "nac_convocatorias.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"election_id", type text}, {"election_type", type text}, {"anno", Int64.Type}, {"mes", Int64.Type}, {"fecha", type text}, {"convocatoria", type text}, {"orden", Int64.Type}}, "en-US")
				in
				    Tipos

