table 'PIB provincia'
	lineageTag: e092fe88-f226-4683-abe5-60bd5dc0a9bc

	column provincia_ine
		dataType: string
		isHidden
		lineageTag: 6caba167-7d81-4e71-89c4-44b9db20edd1
		summarizeBy: none
		sourceColumn: provincia_ine

	column anyo
		dataType: int64
		formatString: 0
		lineageTag: 345b8d3b-e5f5-49c1-a193-e8df7b8fa733
		summarizeBy: none
		sourceColumn: anyo

	column pib_pc
		dataType: double
		formatString: #,0 €
		lineageTag: 850dd0e4-44b1-4a4e-a06d-cafb462f3999
		summarizeBy: none
		sourceColumn: pib_pc

	partition 'PIB provincia' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "pib_provincia.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"provincia_ine", type text}, {"anyo", Int64.Type}, {"pib_pc", type number}}, "en-US")
				in
				    Tipos

