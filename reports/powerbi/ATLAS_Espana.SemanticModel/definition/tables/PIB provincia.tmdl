table 'PIB provincia'

	column provincia_ine
		dataType: string
		summarizeBy: none
		sourceColumn: provincia_ine
		isHidden

	column anyo
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: anyo

	column pib_pc
		dataType: double
		formatString: #,0 €
		summarizeBy: none
		sourceColumn: pib_pc

	partition 'PIB provincia' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "pib_provincia.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"provincia_ine", type text}, {"anyo", Int64.Type}, {"pib_pc", type number}}, "en-US")
				in
				    Tipos

