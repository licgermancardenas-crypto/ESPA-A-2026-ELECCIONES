table 'Métrica del mapa'

	column id
		dataType: int64
		summarizeBy: none
		sourceColumn: [id]
		isHidden

	column 'Métrica'
		dataType: string
		summarizeBy: none
		sourceColumn: [Métrica]
		sortByColumn: id

	partition 'Métrica del mapa' = calculated
		mode: import
		source =
				DATATABLE("id", INTEGER, "Métrica", STRING, {
				    {1, "Variación de población 10 años"},
				    {2, "Densidad (hab./km²)"},
				    {3, "Población"},
				    {4, "PIB per cápita (provincia)"},
				    {5, "Tasa de paro EPA (CCAA)"}
				})

