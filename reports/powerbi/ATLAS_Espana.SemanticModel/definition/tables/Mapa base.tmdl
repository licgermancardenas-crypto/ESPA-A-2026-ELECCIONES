table 'Mapa base'

	column id
		dataType: int64
		summarizeBy: none
		sourceColumn: [id]
		isHidden

	column 'Mapa base'
		dataType: string
		summarizeBy: none
		sourceColumn: [Mapa base]
		sortByColumn: id

	partition 'Mapa base' = calculated
		mode: import
		source =
				DATATABLE("id", INTEGER, "Mapa base", STRING, {{1, "Mapa"}, {2, "Satélite"}})

