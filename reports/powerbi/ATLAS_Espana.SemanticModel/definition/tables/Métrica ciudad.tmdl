table 'Métrica ciudad'

	column id
		dataType: int64
		summarizeBy: none
		sourceColumn: [id]
		isHidden

	column 'Métrica'
		dataType: string
		summarizeBy: none
		sourceColumn: [Métrica]
		sortByColumn: id

	partition 'Métrica ciudad' = calculated
		mode: import
		source =
				DATATABLE("id", INTEGER, "Métrica", STRING, {
				    {1, "Renta neta media por persona"},
				    {2, "Densidad (hab./km²)"},
				    {3, "Población de 65 y más años"},
				    {4, "Población de la sección"}
				})

