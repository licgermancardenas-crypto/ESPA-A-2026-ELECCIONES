	measure 'Color partido' = VAR p = UPPER(SELECTEDVALUE('Elecciones regionales'[candidatura])) RETURN SWITCH(TRUE(), LEFT(p, 7) = "EAJ-PNV", "#2E7D32", LEFT(p, 3) = "EAJ", "#2E7D32", LEFT(p, 3) = "PNV", "#2E7D32", LEFT(p, 8) = "EH BILDU", "#00A39A", LEFT(p, 5) = "BILDU", "#00A39A", LEFT(p, 2) = "EH", "#00A39A", LEFT(p, 2) = "HB", "#00A39A", LEFT(p, 6) = "AMAIUR", "#00A39A", LEFT(p, 3) = "PSE", "#E30613", LEFT(p, 4) = "PSOE", "#E30613", LEFT(p, 3) = "PSC", "#E30613", LEFT(p, 2) = "PP", "#1E5BA8", LEFT(p, 2) = "AP", "#1E5BA8", LEFT(p, 2) = "CP", "#1E5BA8", LEFT(p, 3) = "UPN", "#1E5BA8", LEFT(p, 10) = "MÁS MADRID", "#0FDEC4", LEFT(p, 10) = "MAS MADRID", "#0FDEC4", LEFT(p, 4) = "UPYD", "#E5007E", LEFT(p, 5) = "RESTO", "#B8B2C8", LEFT(p, 7) = "PODEMOS", "#6B2C91", LEFT(p, 10) = "ELKARREKIN", "#6B2C91", LEFT(p, 5) = "SUMAR", "#E5007E", LEFT(p, 3) = "VOX", "#5AC035", LEFT(p, 2) = "EA", "#8DB600", LEFT(p, 2) = "EE", "#B71C1C", LEFT(p, 2) = "EB", "#9C2B2B", LEFT(p, 2) = "IU", "#9C2B2B", LEFT(p, 3) = "PCE", "#9C2B2B", LEFT(p, 3) = "UCD", "#F28C28", LEFT(p, 3) = "C´S", "#EB6109", LEFT(p, 2) = "CS", "#EB6109", LEFT(p, 10) = "CIUDADANOS", "#EB6109", LEFT(p, 2) = "UA", "#4E6B8A", "#9A93AD")
		displayFolder: Formato
		lineageTag: a4c5de3b-c799-475c-ae5d-55b75e9bebda

	measure 'SVG Euskadi ganador' =
			VAR provs = CALCULATETABLE(VALUES('Participación regional'[provincia_ine]))
			VAR cc = MAXX(FILTER(ALL(Provincias), Provincias[provincia_ine] IN provs), Provincias[ccaa_ine])
			VAR ancho = LOOKUPVALUE(CCAA[lienzo_ancho], CCAA[ccaa_ine], cc)
			VAR alto = LOOKUPVALUE(CCAA[lienzo_alto], CCAA[ccaa_ine], cc)
			VAR t = ADDCOLUMNS(CALCULATETABLE(Municipios, REMOVEFILTERS(Municipios), Municipios[ccaa_ine] = cc), "@g",
			    CALCULATE(SELECTEDVALUE('Participación regional'[ganador]), 'Participación regional'[nivel] = "municipio"))
			VAR formas = CONCATENATEX(t,
			    VAR g = UPPER([@g])
			    VAR c = IF(ISBLANK([@g]), "#E4E0EC", SWITCH(TRUE(), LEFT(g, 7) = "EAJ-PNV", "#2E7D32", LEFT(g, 3) = "EAJ", "#2E7D32", LEFT(g, 3) = "PNV", "#2E7D32", LEFT(g, 8) = "EH BILDU", "#00A39A", LEFT(g, 5) = "BILDU", "#00A39A", LEFT(g, 2) = "EH", "#00A39A", LEFT(g, 2) = "HB", "#00A39A", LEFT(g, 6) = "AMAIUR", "#00A39A", LEFT(g, 3) = "PSE", "#E30613", LEFT(g, 4) = "PSOE", "#E30613", LEFT(g, 3) = "PSC", "#E30613", LEFT(g, 2) = "PP", "#1E5BA8", LEFT(g, 2) = "AP", "#1E5BA8", LEFT(g, 2) = "CP", "#1E5BA8", LEFT(g, 3) = "UPN", "#1E5BA8", LEFT(g, 10) = "MÁS MADRID", "#0FDEC4", LEFT(g, 10) = "MAS MADRID", "#0FDEC4", LEFT(g, 4) = "UPYD", "#E5007E", LEFT(g, 5) = "RESTO", "#B8B2C8", LEFT(g, 7) = "PODEMOS", "#6B2C91", LEFT(g, 10) = "ELKARREKIN", "#6B2C91", LEFT(g, 5) = "SUMAR", "#E5007E", LEFT(g, 3) = "VOX", "#5AC035", LEFT(g, 2) = "EA", "#8DB600", LEFT(g, 2) = "EE", "#B71C1C", LEFT(g, 2) = "EB", "#9C2B2B", LEFT(g, 2) = "IU", "#9C2B2B", LEFT(g, 3) = "PCE", "#9C2B2B", LEFT(g, 3) = "UCD", "#F28C28", LEFT(g, 3) = "C´S", "#EB6109", LEFT(g, 2) = "CS", "#EB6109", LEFT(g, 10) = "CIUDADANOS", "#EB6109", LEFT(g, 2) = "UA", "#4E6B8A", "#9A93AD"))
			    RETURN "<path d='" & Municipios[path_ccaa] & "' fill='" & c & "'/>", "")
			VAR partidos = ADDCOLUMNS(DISTINCT(SELECTCOLUMNS(FILTER(t, NOT ISBLANK([@g])), "@g", [@g])),
			    "@n", COUNTROWS(FILTER(t, [@g] = EARLIER([@g]))))
			VAR ley = CONCATENATEX(TOPN(8, partidos, [@n], DESC),
			    VAR g = UPPER([@g])
			    VAR i = RANKX(partidos, [@n], , DESC, Dense)
			    RETURN "<rect x='10' y='" & (alto + 10 + i * 24) & "' width='22' height='16' rx='3' fill='" & SWITCH(TRUE(), LEFT(g, 7) = "EAJ-PNV", "#2E7D32", LEFT(g, 3) = "EAJ", "#2E7D32", LEFT(g, 3) = "PNV", "#2E7D32", LEFT(g, 8) = "EH BILDU", "#00A39A", LEFT(g, 5) = "BILDU", "#00A39A", LEFT(g, 2) = "EH", "#00A39A", LEFT(g, 2) = "HB", "#00A39A", LEFT(g, 6) = "AMAIUR", "#00A39A", LEFT(g, 3) = "PSE", "#E30613", LEFT(g, 4) = "PSOE", "#E30613", LEFT(g, 3) = "PSC", "#E30613", LEFT(g, 2) = "PP", "#1E5BA8", LEFT(g, 2) = "AP", "#1E5BA8", LEFT(g, 2) = "CP", "#1E5BA8", LEFT(g, 3) = "UPN", "#1E5BA8", LEFT(g, 10) = "MÁS MADRID", "#0FDEC4", LEFT(g, 10) = "MAS MADRID", "#0FDEC4", LEFT(g, 4) = "UPYD", "#E5007E", LEFT(g, 5) = "RESTO", "#B8B2C8", LEFT(g, 7) = "PODEMOS", "#6B2C91", LEFT(g, 10) = "ELKARREKIN", "#6B2C91", LEFT(g, 5) = "SUMAR", "#E5007E", LEFT(g, 3) = "VOX", "#5AC035", LEFT(g, 2) = "EA", "#8DB600", LEFT(g, 2) = "EE", "#B71C1C", LEFT(g, 2) = "EB", "#9C2B2B", LEFT(g, 2) = "IU", "#9C2B2B", LEFT(g, 3) = "PCE", "#9C2B2B", LEFT(g, 3) = "UCD", "#F28C28", LEFT(g, 3) = "C´S", "#EB6109", LEFT(g, 2) = "CS", "#EB6109", LEFT(g, 10) = "CIUDADANOS", "#EB6109", LEFT(g, 2) = "UA", "#4E6B8A", "#9A93AD") & "'/>"
			        & "<text x='40' y='" & (alto + 23 + i * 24) & "' font-family='Segoe UI' font-size='14' fill='#1D1631'>"
			        & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE([@g], "&", "&amp;"), "<", "&lt;"), ">", "&gt;") & " · " & [@n] & IF([@n] = 1, " municipio", " municipios") & "</text>", "", [@n], DESC)
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & ancho & " " & (alto + 230) & "'>"
			    & "<text x='10' y='" & (alto + 22) & "' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Partido más votado por municipio</text>"
			    & "<g stroke='#FFFFFF' stroke-width='0.8' stroke-linejoin='round'>" & formas & "</g>" & ley & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Formato
		lineageTag: 60689ece-3506-40a9-950f-c14ffa00306b
		dataCategory: ImageUrl

