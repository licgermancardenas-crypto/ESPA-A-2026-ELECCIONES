eight='700' fill='#1D1631'>Población</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#F3EFF9' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 0,5 M</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#D9CDEE' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>0,5–1 M</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#B19DDA' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>1–2 M</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#8467BD' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>2–4 M</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#5B3F99' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>4–7 M</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#2E1B5E' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 7 M</text>")
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 945'>" & "<g stroke='#FFFFFF' stroke-width='0.15' stroke-linejoin='round'>" & grupos & "</g>" & "<g fill='none' stroke='#1D1631' stroke-opacity='0.6' stroke-width='0.9'>" & prov & "</g>" & "<path d='M395 945 395 804 4 804 4 945Z' fill='none' stroke='#6B6480' stroke-width='1' stroke-dasharray='5 4'/><text x='14' y='937' font-family='Segoe UI' font-size='12' fill='#6B6480'>Canarias (escala 0,85)</text>" & leyenda & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
