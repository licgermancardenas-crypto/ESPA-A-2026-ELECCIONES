	measure 'SVG España municipios' =
			VAR idm = SELECTEDVALUE('Métrica del mapa'[id], 1)
			VAR sel = VALUES(CCAA[ccaa_ine])
			VAR todo = NOT ISFILTERED(CCAA[ccaa_ine]) && NOT ISFILTERED(CCAA[nombre])
			VAR t = ADDCOLUMNS(ALL(Municipios), "@c",
			    VAR v = SWITCH(idm, 1, DIVIDE(Municipios[pob_actual] - Municipios[pob_hace10], Municipios[pob_hace10]), 2, DIVIDE(Municipios[pob_actual], Municipios[area_km2]), 3, Municipios[pob_actual], 4, RELATED(Provincias[pib_pc]), 5, RELATED(CCAA[paro]))
			    RETURN IF(todo || Municipios[ccaa_ine] IN sel, IF(ISBLANK(v), "#E4E0EC", SWITCH(idm, 1, SWITCH(TRUE(), v < -0.1, "#8A5A00", v < -0.05, "#C98A12", v < 0, "#F2D58C", v < 0.05, "#CDBFE6", v < 0.1, "#8E73C4", "#4B2F8A"), 2, SWITCH(TRUE(), v < 10, "#F3EFF9", v < 25, "#D9CDEE", v < 100, "#B19DDA", v < 300, "#8467BD", v < 1000, "#5B3F99", "#2E1B5E"), 3, SWITCH(TRUE(), v < 1000, "#F3EFF9", v < 5000, "#D9CDEE", v < 20000, "#B19DDA", v < 100000, "#8467BD", v < 500000, "#5B3F99", "#2E1B5E"), 4, SWITCH(TRUE(), v < 22000, "#FFF6DD", v < 25000, "#F8DE9A", v < 28000, "#E9B949", v < 32000, "#C98A12", v < 36000, "#8A5A00", "#5C3B00"), 5, SWITCH(TRUE(), v < 0.07, "#EAF4F2", v < 0.09, "#BFE0DA", v < 0.11, "#7CC2B6", v < 0.13, "#2E9C8F", v < 0.15, "#1F6E66", "#0E3F3A"), 33, SWITCH(TRUE(), v < 500000, "#F3EFF9", v < 1000000, "#D9CDEE", v < 2000000, "#B19DDA", v < 4000000, "#8467BD", v < 7000000, "#5B3F99", "#2E1B5E"))), "#EEEBF3"))
