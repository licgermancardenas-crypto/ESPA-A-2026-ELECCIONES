	measure 'Más votado (nac)' =
			VAR t = ADDCOLUMNS(VALUES('Resultados familia'[familia]), "@v", [Votos (nac)])
			RETURN MAXX(TOPN(1, FILTER(t, 'Resultados familia'[familia] <> "Otros"), [@v], DESC), 'Resultados familia'[familia])
		displayFolder: Elecciones
		lineageTag: b30073ec-d725-405d-b64f-5ed3721e8ace

	measure 'ENEP (nac)' = VAR g = [Territorio electoral] RETURN CALCULATE(AVERAGE('Índices electorales'[enep]), 'Índices electorales'[geo_id] = g, REMOVEFILTERS(CCAA))
		formatString: 0.00
