	measure 'Color familia' = VAR f = SELECTEDVALUE('Resultados familia'[familia]) RETURN SWITCH(f, "PSOE", "#E30613", "PP", "#1E5BA8", "Vox", "#5AC035", "Ciudadanos", "#EB6109", "Podemos y confluencias", "#6B2C91", "Sumar", "#E5007E", "ERC", "#F5A800", "Convergència / Junts", "#00B4C5", "PNV", "#2E7D32", "EH Bildu", "#00897B", "BNG", "#76B3E0", "Coalición Canaria", "#F2D500", "Más País", "#0FDEC4", "Compromís", "#DF7F2A", "IU", "#9C2B2B", "UPN", "#3E6FB4", "NA+ (coalición UPN-PP-Cs)", "#3E6FB4", "PRC", "#A4C639", "CUP", "#FFE600", "Teruel Existe", "#037252", "Ahora Repúblicas (coalición)", "#F08A00", "CEUS (coalición)", "#4CAF50", "CPE (coalición)", "#8BC34A", "Se Acabó La Fiesta", "#8B5A2B", "PACMA", "#8EC43F", "UPyD", "#E5007E", "Nueva Canarias", "#7FB5DA", "Otros", "#B8B2C8", "#B8B2C8")
		displayFolder: Formato
		lineageTag: 1003901c-82eb-40d9-bfac-1c99430f0855

	measure 'Título elecciones' =
			SELECTEDVALUE('Convocatorias nacionales'[convocatoria], "Elegí una convocatoria") & " · " &
			IF([Territorio electoral] = "ES", "España", SELECTEDVALUE(CCAA[nombre])) & " · partido más votado por " &
			IF(SELECTEDVALUE('Nivel del mapa'[id], 2) = 3, "municipio", "provincia")
		displayFolder: Formato
		lineageTag: 1e7577ba-b9f4-4140-adc7-c70c0d75c152

	measure 'SVG elecciones provincias' =
			VAR sel = VALUES(CCAA[ccaa_ine])
			VAR todo = NOT ISFILTERED(CCAA[ccaa_ine]) && NOT ISFILTERED(CCAA[nombre])
			VAR tp = ADDCOLUMNS(ALL(Provincias), "@f", CALCULATE(SELECTEDVALUE('Ganador provincia'[familia_ganador])))
			VAR provs = CONCATENATEX(tp,
			    VAR f = [@f]
			    VAR c = IF(todo || Provincias[ccaa_ine] IN sel, IF(ISBLANK(f), "#E4E0EC", SWITCH(f, "PSOE", "#E30613", "PP", "#1E5BA8", "Vox", "#5AC035", "Ciudadanos", "#EB6109", "Podemos y confluencias", "#6B2C91", "Sumar", "#E5007E", "ERC", "#F5A800", "Convergència / Junts", "#00B4C5", "PNV", "#2E7D32", "EH Bildu", "#00897B", "BNG", "#76B3E0", "Coalición Canaria", "#F2D500", "Más País", "#0FDEC4", "Compromís", "#DF7F2A", "IU", "#9C2B2B", "UPN", "#3E6FB4", "NA+ (coalición UPN-PP-Cs)", "#3E6FB4", "PRC", "#A4C639", "CUP", "#FFE600", "Teruel Existe", "#037252", "Ahora Repúblicas (coalición)", "#F08A00", "CEUS (coalición)", "#4CAF50", "CPE (coalición)", "#8BC34A", "Se Acabó La Fiesta", "#8B5A2B", "PACMA", "#8EC43F", "UPyD", "#E5007E", "Nueva Canarias", "#7FB5DA", "Otros", "#B8B2C8", "#B8B2C8")), "#EEEBF3")
			    RETURN "<path d='" & Provincias[path] & "' fill='" & c & "'/>", "")
			VAR cuenta = ADDCOLUMNS(DISTINCT(SELECTCOLUMNS(FILTER(tp, NOT ISBLANK([@f])), "@f", [@f])),
			    "@n", COUNTROWS(FILTER(tp, [@f] = EARLIER([@f]))))
			VAR ley = CONCATENATEX(ADDCOLUMNS(TOPN(9, cuenta, [@n], DESC), "@k", [@n] * 100000 + UNICODE([@f]) * 100 + LEN([@f])), VAR f = [@f] VAR i = RANKX(ADDCOLUMNS(TOPN(9, cuenta, [@n], DESC), "@k", [@n] * 100000 + UNICODE([@f]) * 100 + LEN([@f])), [@k], , DESC) RETURN "<rect x='700' y='" & (945 - 250 + i * 22) & "' width='20' height='15' rx='3' fill='" & SWITCH(f, "PSOE", "#E30613", "PP", "#1E5BA8", "Vox", "#5AC035", "Ciudadanos", "#EB6109", "Podemos y confluencias", "#6B2C91", "Sumar", "#E5007E", "ERC", "#F5A800", "Convergència / Junts", "#00B4C5", "PNV", "#2E7D32", "EH Bildu", "#00897B", "BNG", "#76B3E0", "Coalición Canaria", "#F2D500", "Más País", "#0FDEC4", "Compromís", "#DF7F2A", "IU", "#9C2B2B", "UPN", "#3E6FB4", "NA+ (coalición UPN-PP-Cs)", "#3E6FB4", "PRC", "#A4C639", "CUP", "#FFE600", "Teruel Existe", "#037252", "Ahora Repúblicas (coalición)", "#F08A00", "CEUS (coalición)", "#4CAF50", "CPE (coalición)", "#8BC34A", "Se Acabó La Fiesta", "#8B5A2B", "PACMA", "#8EC43F", "UPyD", "#E5007E", "Nueva Canarias", "#7FB5DA", "Otros", "#B8B2C8", "#B8B2C8") & "'/><text x='728' y='" & (945 - 237 + i * 22) & "' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & SUBSTITUTE(f, "&", "&amp;") & " · " & [@n] & "</text>", "", [@k], DESC)
			VAR cuerpo = "<g stroke='#FFFFFF' stroke-width='0.9' stroke-linejoin='round'>" & provs & "</g>"
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 945'>" & cuerpo & "<path d='M395 945 395 804 4 804 4 945Z' fill='none' stroke='#6B6480' stroke-width='1' stroke-dasharray='5 4'/><text x='14' y='937' font-family='Segoe UI' font-size='12' fill='#6B6480'>Canarias (escala 0,85)</text>" & ley & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Formato
		lineageTag: 36485aff-cf1b-4b27-9f1f-a7aa80f6dcd6
		dataCategory: ImageUrl

	measure 'SVG elecciones municipios' =
			VAR sel = VALUES(CCAA[ccaa_ine])
			VAR todo = NOT ISFILTERED(CCAA[ccaa_ine]) && NOT ISFILTERED(CCAA[nombre])
			VAR tm = ADDCOLUMNS(ALL(Municipios), "@f", CALCULATE(SELECTEDVALUE('Ganador municipio'[familia_ganador])))
			VAR munis = CONCATENATEX(DISTINCT(SELECTCOLUMNS(tm, "@f", [@f])),
			    VAR fam = [@f]
			    VAR c = IF(ISBLANK(fam), "#E4E0EC", SWITCH(fam, "PSOE", "#E30613", "PP", "#1E5BA8", "Vox", "#5AC035", "Ciudadanos", "#EB6109", "Podemos y confluencias", "#6B2C91", "Sumar", "#E5007E", "ERC", "#F5A800", "Convergència / Junts", "#00B4C5", "PNV", "#2E7D32", "EH Bildu", "#00897B", "BNG", "#76B3E0", "Coalición Canaria", "#F2D500", "Más País", "#0FDEC4", "Compromís", "#DF7F2A", "IU", "#9C2B2B", "UPN", "#3E6FB4", "NA+ (coalición UPN-PP-Cs)", "#3E6FB4", "PRC", "#A4C639", "CUP", "#FFE600", "Teruel Existe", "#037252", "Ahora Repúblicas (coalición)", "#F08A00", "CEUS (coalición)", "#4CAF50", "CPE (coalición)", "#8BC34A", "Se Acabó La Fiesta", "#8B5A2B", "PACMA", "#8EC43F", "UPyD", "#E5007E", "Nueva Canarias", "#7FB5DA", "Otros", "#B8B2C8", "#B8B2C8"))
			    RETURN "<g fill='" & c & "'>" & CONCATENATEX(FILTER(tm, [@f] = fam && (todo || Municipios[ccaa_ine] IN sel)),
			        "<path d='" & Municipios[path] & "'/>", "") & "</g>", "")
			VAR fondo = CONCATENATEX(ALL(Provincias), "<path d='" & Provincias[path] & "'/>", "")
			VAR cuenta = ADDCOLUMNS(DISTINCT(SELECTCOLUMNS(FILTER(tm, NOT ISBLANK([@f])), "@f", [@f])),
			    "@n", COUNTROWS(FILTER(tm, [@f] = EARLIER([@f]))))
			VAR ley = CONCATENATEX(ADDCOLUMNS(TOPN(9, cuenta, [@n], DESC), "@k", [@n] * 100000 + UNICODE([@f]) * 100 + LEN([@f])), VAR f = [@f] VAR i = RANKX(ADDCOLUMNS(TOPN(9, cuenta, [@n], DESC), "@k", [@n] * 100000 + UNICODE([@f]) * 100 + LEN([@f])), [@k], , DESC) RETURN "<rect x='700' y='" & (945 - 250 + i * 22) & "' width='20' height='15' rx='3' fill='" & SWITCH(f, "PSOE", "#E30613", "PP", "#1E5BA8", "Vox", "#5AC035", "Ciudadanos", "#EB6109", "Podemos y confluencias", "#6B2C91", "Sumar", "#E5007E", "ERC", "#F5A800", "Convergència / Junts", "#00B4C5", "PNV", "#2E7D32", "EH Bildu", "#00897B", "BNG", "#76B3E0", "Coalición Canaria", "#F2D500", "Más País", "#0FDEC4", "Compromís", "#DF7F2A", "IU", "#9C2B2B", "UPN", "#3E6FB4", "NA+ (coalición UPN-PP-Cs)", "#3E6FB4", "PRC", "#A4C639", "CUP", "#FFE600", "Teruel Existe", "#037252", "Ahora Repúblicas (coalición)", "#F08A00", "CEUS (coalición)", "#4CAF50", "CPE (coalición)", "#8BC34A", "Se Acabó La Fiesta", "#8B5A2B", "PACMA", "#8EC43F", "UPyD", "#E5007E", "Nueva Canarias", "#7FB5DA", "Otros", "#B8B2C8", "#B8B2C8") & "'/><text x='728' y='" & (945 - 237 + i * 22) & "' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & SUBSTITUTE(f, "&", "&amp;") & " · " & [@n] & "</text>", "", [@k], DESC)
			VAR cuerpo = "<g fill='#EEEBF3'>" & fondo & "</g><g stroke='#FFFFFF' stroke-width='0.15'>" & munis & "</g>"
			    & "<g fill='none' stroke='#1D1631' stroke-opacity='0.6' stroke-width='0.9'>" & fondo & "</g>"
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 945'>" & cuerpo & "<path d='M395 945 395 804 4 804 4 945Z' fill='none' stroke='#6B6480' stroke-width='1' stroke-dasharray='5 4'/><text x='14' y='937' font-family='Segoe UI' font-size='12' fill='#6B6480'>Canarias (escala 0,85)</text>" & ley & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Formato
		lineageTag: 9290ada2-78d3-4c92-a05e-9faf4973d4a9
		dataCategory: ImageUrl

	measure 'SVG elecciones' = IF(SELECTEDVALUE('Nivel del mapa'[id], 2) = 3, [SVG elecciones municipios], [SVG elecciones provincias])
		displayFolder: Formato
		lineageTag: 3c766c5b-c184-4889-ae3c-454d9f130753
		dataCategory: ImageUrl

	column Value
		dataType: string
		isHidden
		lineageTag: 94c348e1-facd-4471-aecf-2509aa7430cf
		summarizeBy: none
		sourceColumn: [Value]

	partition Medidas = calculated
		mode: import
		source = {BLANK()}

