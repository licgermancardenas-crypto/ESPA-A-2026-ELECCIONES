 UI' font-size='13' fill='#1D1631'>22–25 k€</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#E9B949' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>25–28 k€</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#C98A12' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>28–32 k€</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#8A5A00' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>32–36 k€</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#5C3B00' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 36 k€</text>", 5, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Tasa de paro EPA (CCAA)</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#EAF4F2' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 7 %</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#BFE0DA' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>7–9 %</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#7CC2B6' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>9–11 %</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#2E9C8F' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>11–13 %</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#1F6E66' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>13–15 %</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#0E3F3A' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 15 %</text>", 33, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Población</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#F3EFF9' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 0,5 M</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#D9CDEE' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>0,5–1 M</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#B19DDA' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>1–2 M</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#8467BD' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>2–4 M</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#5B3F99' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>4–7 M</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#2E1B5E' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 7 M</text>")
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 945'>" & "<g stroke='#FFFFFF' stroke-width='0.8' stroke-linejoin='round'>" & formas & "</g>" & "<g fill='none' stroke='#1D1631' stroke-opacity='0.7' stroke-width='1.4'>" & ccaa & "</g>" & "<path d='M395 945 395 804 4 804 4 945Z' fill='none' stroke='#6B6480' stroke-width='1' stroke-dasharray='5 4'/><text x='14' y='937' font-family='Segoe UI' font-size='12' fill='#6B6480'>Canarias (escala 0,85)</text>" & leyenda & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Formato
		dataCategory: ImageUrl

	measure 'SVG España municipios' =
			VAR idm = SELECTEDVALUE('Métrica del mapa'[id], 1)
			VAR sel = VALUES(CCAA[ccaa_ine])
			VAR todo = NOT ISFILTERED(CCAA[ccaa_ine]) && NOT ISFILTERED(CCAA[nombre])
			VAR t = ADDCOLUMNS(ALL(Municipios), "@c",
			    VAR v = SWITCH(idm, 1, DIVIDE(Municipios[pob_actual] - Municipios[pob_hace10], Municipios[pob_hace10]), 2, DIVIDE(Municipios[pob_actual], Municipios[area_km2]), 3, Municipios[pob_actual], 4, RELATED(Provincias[pib_pc]), 5, RELATED(CCAA[paro]))
			    RETURN IF(todo || Municipios[ccaa_ine] IN sel, IF(ISBLANK(v), "#E4E0EC", SWITCH(idm, 1, SWITCH(TRUE(), v < -0.1, "#8A5A00", v < -0.05, "#C98A12", v < 0, "#F2D58C", v < 0.05, "#CDBFE6", v < 0.1, "#8E73C4", "#4B2F8A"), 2, SWITCH(TRUE(), v < 10, "#F3EFF9", v < 25, "#D9CDEE", v < 100, "#B19DDA", v < 300, "#8467BD", v < 1000, "#5B3F99", "#2E1B5E"), 3, SWITCH(TRUE(), v < 1000, "#F3EFF9", v < 5000, "#D9CDEE", v < 20000, "#B19DDA", v < 100000, "#8467BD", v < 500000, "#5B3F99", "#2E1B5E"), 4, SWITCH(TRUE(), v < 22000, "#FFF6DD", v < 25000, "#F8DE9A", v < 28000, "#E9B949", v < 32000, "#C98A12", v < 36000, "#8A5A00", "#5C3B00"), 5, SWITCH(TRUE(), v < 0.07, "#EAF4F2", v < 0.09, "#BFE0DA", v < 0.11, "#7CC2B6", v < 0.13, "#2E9C8F", v < 0.15, "#1F6E66", "#0E3F3A"), 33, SWITCH(TRUE(), v < 500000, "#F3EFF9", v < 1000000, "#D9CDEE", v < 2000000, "#B19DDA", v < 4000000, "#8467BD", v < 7000000, "#5B3F99", "#2E1B5E"))), "#EEEBF3"))
			VAR grupos = CONCATENATEX(DISTINCT(SELECTCOLUMNS(t, "@c", [@c])),
			    VAR col = [@c]
			    RETURN "<g fill='" & col & "'>" & CONCATENATEX(FILTER(t, [@c] = col), "<path d='" & Municipios[path] & "'/>", "") & "</g>", "")
			VAR prov = CONCATENATEX(ALL(Provincias), "<path d='" & Provincias[path] & "'/>", "")
			VAR leyenda = SWITCH(idm, 1, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Variación de población 10 años</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#8A5A00' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; −10 %</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#C98A12' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>−10 a −5 %</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#F2D58C' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>−5 a 0 %</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#CDBFE6' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>0 a 5 %</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#8E73C4' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>5 a 10 %</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#4B2F8A' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 10 %</text>", 2, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Densidad (hab./km²)</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#F3EFF9' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 10</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#D9CDEE' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>10–25</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#B19DDA' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>25–100</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#8467BD' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-siz