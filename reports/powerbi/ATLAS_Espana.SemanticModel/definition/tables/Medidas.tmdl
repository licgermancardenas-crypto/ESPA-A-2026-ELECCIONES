table Medidas
	lineageTag: 344630a5-6e09-46bf-8711-31c75223281e

	measure Corte = "Datos a 10/11/2026 04:53 · Fuentes: INE, Eurostat, Congreso"
		displayFolder: Formato
		lineageTag: 2ea67cbf-9dc2-4a71-8d84-cf25d2a562b9

	measure Población = SUM(Municipios[pob_actual])
		formatString: #,0
		displayFolder: Demografía
		lineageTag: fd5e235e-1f77-4501-8358-b61399f14741

	measure 'Población hace 10 años' = SUM(Municipios[pob_hace10])
		formatString: #,0
		displayFolder: Demografía
		lineageTag: 70f0b114-c003-445a-964f-885a2a1a4766

	measure 'Variación población 10 años' =
			VAR conAmbos = FILTER(Municipios, NOT ISBLANK(Municipios[pob_hace10]) && NOT ISBLANK(Municipios[pob_actual]))
			VAR a = SUMX(conAmbos, Municipios[pob_actual])
			VAR b = SUMX(conAmbos, Municipios[pob_hace10])
			RETURN DIVIDE(a - b, b)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Demografía
		lineageTag: 0a1f2981-54e5-4cf9-9778-5f8949a69c4e

	measure Densidad = DIVIDE([Población], SUM(Municipios[area_km2]))
		formatString: #,0.0
		displayFolder: Demografía
		lineageTag: 55761699-8886-4940-a9a4-5b81c5d8905e

	measure Municipios = COUNTROWS(Municipios)
		formatString: #,0
		displayFolder: Demografía
		lineageTag: df4c5efc-b2b4-463d-8f2e-73a92bfcafe7

	measure 'Municipios que pierden población' = COUNTROWS(FILTER(Municipios, Municipios[pob_actual] < Municipios[pob_hace10]))
		formatString: #,0
		displayFolder: Demografía
		lineageTag: da53864a-9a94-464f-acb3-985e88874802

	measure '% municipios que pierden población' = DIVIDE([Municipios que pierden población], [Municipios])
		formatString: 0.0%
		displayFolder: Demografía
		lineageTag: 6fb31d8c-87ca-4139-8150-92edbe4f6a5f

	measure Provincias = DISTINCTCOUNT(Municipios[provincia_ine])
		formatString: 0
		displayFolder: Demografía
		lineageTag: 32fbbe95-7529-4797-b42b-73031f3721a0

	measure Comunidades = DISTINCTCOUNT(Municipios[ccaa_ine])
		formatString: 0
		displayFolder: Demografía
		lineageTag: 2c37bbda-d929-4a8a-8b8f-d744869d96ce

	measure 'Población (serie)' = SUM('Serie población'[poblacion])
		formatString: #,0
		displayFolder: Demografía
		lineageTag: eff89f4b-6196-4a7a-88d0-8953f52f20a1

	measure 'Año actual' = 2025
		formatString: 0
		displayFolder: Demografía
		lineageTag: fb87d791-2d0a-4f0c-bad3-10529ffbb19c

	measure 'PIB per cápita' =
			VAR t = FILTER(Provincias, NOT ISBLANK(Provincias[pib_pc]))
			RETURN DIVIDE(SUMX(t, Provincias[pib_pc] * Provincias[pob_actual]), SUMX(t, Provincias[pob_actual]))
		formatString: #,0 €
		displayFolder: Economía
		lineageTag: 7bd77125-5058-4636-9b05-54298abd2db2

	measure 'PIB per cápita (serie)' = AVERAGE('PIB provincia'[pib_pc])
		formatString: #,0 €
		displayFolder: Economía
		lineageTag: a09d0d35-17de-42b6-a5bc-e6c6f5369af9

	measure 'Tasa de paro' =
			VAR ult = CALCULATE(MAX(Paro[trimestre]), ALL(Paro))
			RETURN IF(HASONEVALUE(CCAA[ccaa_ine]),
			    CALCULATE(AVERAGE(Paro[tasa_paro]), Paro[trimestre] = ult) / 100,
			    CALCULATE(AVERAGE(Paro[tasa_paro]), Paro[trimestre] = ult, Paro[ccaa_ine] = "00", REMOVEFILTERS(CCAA)) / 100)
		formatString: 0.0%
		displayFolder: Economía
		lineageTag: aea4cdf7-b32f-4086-a706-c57e150ee91c

	measure 'Tasa de paro (serie)' = AVERAGE(Paro[tasa_paro]) / 100
		formatString: 0.0%
		displayFolder: Economía
		lineageTag: be11a8d7-103c-4871-9934-2add50917ca4

	measure 'Trimestre EPA' = CALCULATE(MAX(Paro[trimestre]), ALL(Paro))
		displayFolder: Economía
		lineageTag: 741aa46d-8cf7-4b8c-902d-01edfdcd1921

	measure 'Electores Andalucía 2026' = SUM(Municipios[electores_and_2026])
		formatString: #,0
		displayFolder: Electoral
		lineageTag: bc47c8a3-0d20-4621-9439-e9fd5acc862d

	measure 'Electores / población' =
			VAR t = FILTER(Municipios, NOT ISBLANK(Municipios[electores_and_2026]))
			RETURN DIVIDE(SUMX(t, Municipios[electores_and_2026]), SUMX(t, Municipios[pob_actual]))
		formatString: 0.0%
		displayFolder: Electoral
		lineageTag: 87b64238-3527-4b09-8e5a-63e95349331d

	measure 'Fuentes catalogadas' = COUNTROWS(Fuentes)
		formatString: 0
		displayFolder: Operaciones
		lineageTag: 15947386-136f-4cd7-894c-942fd2396d76

	measure 'Fuentes disponibles' = COUNTROWS(FILTER(Fuentes, Fuentes[estado] = "disponible"))
		formatString: 0
		displayFolder: Operaciones
		lineageTag: 8fa4b7f5-c7a7-45ef-ac02-9996102a93ad

	measure 'Fuentes con conector' = COUNTROWS(FILTER(Fuentes, Fuentes[conector] <> "—"))
		formatString: 0
		displayFolder: Operaciones
		lineageTag: 837f7d53-3b68-46a0-afc0-c97ad38ebf81

	measure 'Filas procesadas' = SUM(Ejecuciones[procesados])
		formatString: #,0
		displayFolder: Operaciones
		lineageTag: d893908d-a2cf-4baf-938b-2b17f9d4735a

	measure 'Controles OK' = COUNTROWS(FILTER(Calidad, Calidad[estado] = "pass"))
		formatString: 0
		displayFolder: Operaciones
		lineageTag: 4453bd52-92d8-45a9-94b9-c3321a0c3709

	measure 'Controles con fallo' = COUNTROWS(FILTER(Calidad, Calidad[estado] = "fail"))
		formatString: 0
		displayFolder: Operaciones
		lineageTag: 55952f9a-8d1c-44a2-988b-ea575754787b

	measure 'Color estado fuente' = SWITCH(SELECTEDVALUE(Fuentes[estado]), "disponible", "#D7EFE9", "bloqueado_antibot", "#F6D1D1", "#FBEBC8")
		displayFolder: Formato
		lineageTag: 2e9eb2e6-4f1a-4844-aa61-f2185db1eea6

	measure 'Color estado control' = SWITCH(SELECTEDVALUE(Calidad[estado]), "pass", "#D7EFE9", "fail", "#F6D1D1", "warn", "#FBEBC8", "#EEEAF4")
		displayFolder: Formato
		lineageTag: 2fee029f-2766-4289-85a6-c85c97588fdc

	measure 'Color estado ejecución' = SWITCH(SELECTEDVALUE(Ejecuciones[estado]), "success", "#D7EFE9", "partial", "#FBEBC8", "#F6D1D1")
		displayFolder: Formato
		lineageTag: 0aee7257-de49-42f0-a40d-2869794681c1

	measure 'Título mapa' = "Mapa · " & SELECTEDVALUE('Métrica del mapa'[Métrica], "Variación de población 10 años")
		displayFolder: Formato
		lineageTag: 5cd09812-36df-4ce9-b663-d76bff32fa10

	measure 'SVG España comunidades' =
			VAR idm = SELECTEDVALUE('Métrica del mapa'[id], 1)
			VAR idc = IF(idm = 3, 33, idm)
			VAR sel = VALUES(CCAA[ccaa_ine])
			VAR todo = NOT ISFILTERED(CCAA[ccaa_ine]) && NOT ISFILTERED(CCAA[nombre])
			VAR formas = CONCATENATEX(ALL(CCAA),
			    VAR v = SWITCH(idm, 1, DIVIDE(CCAA[pob_actual] - CCAA[pob_hace10], CCAA[pob_hace10]), 2, DIVIDE(CCAA[pob_actual], CCAA[area_km2]), 3, CCAA[pob_actual], 4, CCAA[pib_pc], 5, CCAA[paro])
			    VAR c = IF(todo || CCAA[ccaa_ine] IN sel, IF(ISBLANK(v), "#E4E0EC", SWITCH(idc, 1, SWITCH(TRUE(), v < -0.1, "#8A5A00", v < -0.05, "#C98A12", v < 0, "#F2D58C", v < 0.05, "#CDBFE6", v < 0.1, "#8E73C4", "#4B2F8A"), 2, SWITCH(TRUE(), v < 10, "#F3EFF9", v < 25, "#D9CDEE", v < 100, "#B19DDA", v < 300, "#8467BD", v < 1000, "#5B3F99", "#2E1B5E"), 3, SWITCH(TRUE(), v < 1000, "#F3EFF9", v < 5000, "#D9CDEE", v < 20000, "#B19DDA", v < 100000, "#8467BD", v < 500000, "#5B3F99", "#2E1B5E"), 4, SWITCH(TRUE(), v < 22000, "#FFF6DD", v < 25000, "#F8DE9A", v < 28000, "#E9B949", v < 32000, "#C98A12", v < 36000, "#8A5A00", "#5C3B00"), 5, SWITCH(TRUE(), v < 0.07, "#EAF4F2", v < 0.09, "#BFE0DA", v < 0.11, "#7CC2B6", v < 0.13, "#2E9C8F", v < 0.15, "#1F6E66", "#0E3F3A"), 33, SWITCH(TRUE(), v < 500000, "#F3EFF9", v < 1000000, "#D9CDEE", v < 2000000, "#B19DDA", v < 4000000, "#8467BD", v < 7000000, "#5B3F99", "#2E1B5E"))), "#EEEBF3")
			    RETURN "<path d='" & CCAA[path] & "' fill='" & c & "'/>", "")
			VAR etiquetas = CONCATENATEX(ALL(CCAA),
			    VAR v = SWITCH(idm, 1, DIVIDE(CCAA[pob_actual] - CCAA[pob_hace10], CCAA[pob_hace10]), 2, DIVIDE(CCAA[pob_actual], CCAA[area_km2]), 3, CCAA[pob_actual], 4, CCAA[pib_pc], 5, CCAA[paro])
			    VAR txt = SWITCH(idm, 1, FORMAT(v, "+0.0%;-0.0%"), 2, FORMAT(v, "#,0"), 3, FORMAT(v / 1000000, "0.0") & " M", 4, FORMAT(v / 1000, "0.0") & " k€", 5, FORMAT(v, "0.0%"))
			    RETURN IF(CCAA[n_municipios] > 2, "<text x='" & CCAA[cx] & "' y='" & CCAA[cy] & "' text-anchor='middle' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' paint-order='stroke'>" & txt & "</text>"), "")
			VAR leyenda = SWITCH(idc, 1, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Variación de población 10 años</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#8A5A00' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; −10 %</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#C98A12' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>−10 a −5 %</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#F2D58C' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>−5 a 0 %</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#CDBFE6' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>0 a 5 %</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#8E73C4' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>5 a 10 %</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#4B2F8A' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 10 %</text>", 2, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Densidad (hab./km²)</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#F3EFF9' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 10</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#D9CDEE' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>10–25</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#B19DDA' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>25–100</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#8467BD' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>100–300</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#5B3F99' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>300–1.000</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#2E1B5E' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 1.000</text>", 3, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Población</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#F3EFF9' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 1.000</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#D9CDEE' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>1–5 mil</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#B19DDA' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>5–20 mil</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#8467BD' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>20–100 mil</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#5B3F99' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>100–500 mil</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#2E1B5E' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 500 mil</text>", 4, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>PIB per cápita (provincia)</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#FFF6DD' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 22 k€</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#F8DE9A' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>22–25 k€</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#E9B949' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>25–28 k€</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#C98A12' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>28–32 k€</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#8A5A00' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>32–36 k€</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#5C3B00' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 36 k€</text>", 5, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Tasa de paro EPA (CCAA)</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#EAF4F2' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 7 %</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#BFE0DA' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>7–9 %</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#7CC2B6' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>9–11 %</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#2E9C8F' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>11–13 %</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#1F6E66' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>13–15 %</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#0E3F3A' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 15 %</text>", 33, "<text x='720' y='770' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Población</text><rect x='720' y='784' width='22' height='16' rx='3' fill='#F3EFF9' stroke='#FFFFFF'/><text x='750' y='797' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 0,5 M</text><rect x='720' y='806' width='22' height='16' rx='3' fill='#D9CDEE' stroke='#FFFFFF'/><text x='750' y='819' font-family='Segoe UI' font-size='13' fill='#1D1631'>0,5–1 M</text><rect x='720' y='828' width='22' height='16' rx='3' fill='#B19DDA' stroke='#FFFFFF'/><text x='750' y='841' font-family='Segoe UI' font-size='13' fill='#1D1631'>1–2 M</text><rect x='720' y='850' width='22' height='16' rx='3' fill='#8467BD' stroke='#FFFFFF'/><text x='750' y='863' font-family='Segoe UI' font-size='13' fill='#1D1631'>2–4 M</text><rect x='720' y='872' width='22' height='16' rx='3' fill='#5B3F99' stroke='#FFFFFF'/><text x='750' y='885' font-family='Segoe UI' font-size='13' fill='#1D1631'>4–7 M</text><rect x='720' y='894' width='22' height='16' rx='3' fill='#2E1B5E' stroke='#FFFFFF'/><text x='750' y='907' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 7 M</text>")
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 945'>" & "<g stroke='#FFFFFF' stroke-width='1.4' stroke-linejoin='round'>" & formas & "</g>" & etiquetas & "<path d='M395 945 395 804 4 804 4 945Z' fill='none' stroke='#6B6480' stroke-width='1' stroke-dasharray='5 4'/><text x='14' y='937' font-family='Segoe UI' font-size='12' fill='#6B6480'>Canarias (escala 0,85)</text>" & leyenda & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: Formato
		lineageTag: 99d8ca54-4aa9-4dc9-b269-763dd8f69fb8
		dataCategory: ImageUrl

	measure 'SVG España provincias' =
			VAR idm = SELECTEDVALUE('Métrica del mapa'[id], 1)
			VAR idc = IF(idm = 3, 33, idm)
			VAR sel = VALUES(CCAA[ccaa_ine])
			VAR todo = NOT ISFILTERED(CCAA[ccaa_ine]) && NOT ISFILTERED(CCAA[nombre])
			VAR formas = CONCATENATEX(ALL(Provincias),
			    VAR v = SWITCH(idm, 1, DIVIDE(Provincias[pob_actual] - Provincias[pob_hace10], Provincias[pob_hace10]), 2, DIVIDE(Provincias[pob_actual], Provincias[area_km2]), 3, Provincias[pob_actual], 4, Provincias[pib_pc], 5, RELATED(CCAA[paro]))
			    VAR c = IF(todo || Provincias[ccaa_ine] IN sel, IF(ISBLANK(v), "#E4E0EC", SWITCH(idc, 1, SWITCH(TRUE(), v < -0.1, "#8A5A00", v < -0.05, "#C98A12", v < 0, "#F2D58C", v < 0.05, "#CDBFE6", v < 0.1, "#8E73C4", "#4B2F8A"), 2, SWITCH(TRUE(), v < 10, "#F3EFF9", v < 25, "#D9CDEE", v < 100, "#B19DDA", v < 300, "#8467BD", v < 1000, "#5B3F99", "#2E1B5E"), 3, SWITCH(TRUE(), v < 1000, "#F3EFF9", v < 5000, "#D9CDEE", v < 20000, "#B19DDA", v < 100000, "#8467BD", v < 500000, "#5B3F99", "#2E1B5E"), 4, SWITCH(TRUE(), v < 22000, "#FFF6DD", v < 25000, "#F8DE9A", v < 28000, "#E9B949", v < 32000, "#C98A12", v < 36000, "#8A5A00", "#5C3B00"), 5, SWITCH(TRUE(), v < 0.07, "#EAF4F2", v < 0.09, "#BFE0DA", v < 0.11, "#7CC2B6", v < 0.13, "#2E9C8F", v < 0.15, "#1F6E66", "#0E3F3A"), 33, SWITCH(TRUE(), v < 500000, "#F3EFF9", v < 1000000, "#D9CDEE", v < 2000000, "#B19DDA", v < 4000000, "#8467BD", v < 7000000, "#5B3F99", "#2E1B5E"))), "#EEEBF3")
			    RETURN "<path d='" & Provincias[path] & "' fill='" & c & "'/>", "")
			VAR ccaa = CONCATENATEX(ALL(CCAA), "<path d='" & CCAA[path] & "'/>", "")
