	measure 'Renta neta por persona' =
			VAR t = FILTER(Secciones, NOT ISBLANK(Secciones[renta_pp]) && NOT ISBLANK(Secciones[poblacion]))
			RETURN DIVIDE(SUMX(t, Secciones[renta_pp] * Secciones[poblacion]), SUMX(t, Secciones[poblacion]))
		formatString: #,0 €
		displayFolder: Ciudad
		lineageTag: 98c37d6c-0f9f-4440-b1b4-18955e468345

	measure '% 65 y más' =
			VAR t = FILTER(Secciones, NOT ISBLANK(Secciones[pct_65]) && NOT ISBLANK(Secciones[poblacion]))
			RETURN DIVIDE(SUMX(t, Secciones[pct_65] * Secciones[poblacion]), SUMX(t, Secciones[poblacion]))
		formatString: 0.0%
		displayFolder: Ciudad
		lineageTag: 22e56e16-aed9-4e76-a26c-b475a48eec79

	measure 'Densidad secciones' = DIVIDE([Población secciones], SUM(Secciones[area_km2]))
		formatString: #,0
		displayFolder: Ciudad
		lineageTag: 0b17c1cc-aad5-46ed-b6ad-0bb27e288fed

	measure 'Brecha de renta entre secciones' = DIVIDE(MAX(Secciones[renta_pp]), MIN(Secciones[renta_pp]))
		formatString: 0.0
		displayFolder: Ciudad
		lineageTag: 5021748e-2607-449f-9c02-511982933176

	measure 'SVG ciudad' =
			VAR m = SELECTEDVALUE(Municipios[municipio_ine])
			VAR ancho = SELECTEDVALUE(Municipios[lienzo_ancho])
			VAR alto = SELECTEDVALUE(Municipios[lienzo_alto])
			VAR idk = SELECTEDVALUE('Métrica ciudad'[id], 1)
			VAR t = ADDCOLUMNS(CALCULATETABLE(Secciones, REMOVEFILTERS(Secciones), Secciones[municipio_ine] = m), "@c",
			    VAR v = SWITCH(idk, 1, Secciones[renta_pp], 2, DIVIDE(Secciones[poblacion], Secciones[area_km2]),
			                   3, Secciones[pct_65], 4, Secciones[poblacion])
			    RETURN IF(ISBLANK(v), "#E4E0EC", SWITCH(idk, 1, SWITCH(TRUE(), v < 9000, "#FFF6DD", v < 11000, "#F8DE9A", v < 13000, "#E9B949", v < 15000, "#C98A12", v < 18000, "#8A5A00", "#5C3B00"), 2, SWITCH(TRUE(), v < 1000, "#F3EFF9", v < 5000, "#D9CDEE", v < 10000, "#B19DDA", v < 20000, "#8467BD", v < 30000, "#5B3F99", "#2E1B5E"), 3, SWITCH(TRUE(), v < 0.12, "#EAF4F2", v < 0.16, "#BFE0DA", v < 0.2, "#7CC2B6", v < 0.24, "#2E9C8F", v < 0.28, "#1F6E66", "#0E3F3A"), 4, SWITCH(TRUE(), v < 800, "#F3EFF9", v < 1100, "#D9CDEE", v < 1400, "#B19DDA", v < 1700, "#8467BD", v < 2100, "#5B3F99", "#2E1B5E"))))
			VAR grupos = CONCATENATEX(DISTINCT(SELECTCOLUMNS(t, "@c", [@c])),
			    VAR col = [@c]
			    RETURN "<g fill='" & col & "'>" & CONCATENATEX(FILTER(t, [@c] = col), "<path d='" & Secciones[path] & "'/>", "") & "</g>", "")
			VAR dt = CALCULATETABLE('Distritos ciudad', REMOVEFILTERS('Distritos ciudad'), 'Distritos ciudad'[municipio_ine] = m)
			VAR dist = CONCATENATEX(dt, "<path d='" & 'Distritos ciudad'[path] & "'/>", "")
			VAR etiq = CONCATENATEX(dt,
			    "<text x='" & 'Distritos ciudad'[x] & "' y='" & 'Distritos ciudad'[y] & "' text-anchor='middle' font-family='Segoe UI' font-size='16' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3.5' paint-order='stroke'>D" & RIGHT('Distritos ciudad'[cudis], 2) & "</text>", "")
			VAR leyenda = "<g transform='translate(10," & (alto + 24) & ")'>" & SWITCH(idk, 1, "<text x='0' y='16' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Renta neta media por persona</text><rect x='0' y='30' width='22' height='16' rx='3' fill='#FFF6DD' stroke='#FFFFFF'/><text x='30' y='43' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 9.000 €</text><rect x='0' y='52' width='22' height='16' rx='3' fill='#F8DE9A' stroke='#FFFFFF'/><text x='30' y='65' font-family='Segoe UI' font-size='13' fill='#1D1631'>9–11 mil €</text><rect x='0' y='74' width='22' height='16' rx='3' fill='#E9B949' stroke='#FFFFFF'/><text x='30' y='87' font-family='Segoe UI' font-size='13' fill='#1D1631'>11–13 mil €</text><rect x='0' y='96' width='22' height='16' rx='3' fill='#C98A12' stroke='#FFFFFF'/><text x='30' y='109' font-family='Segoe UI' font-size='13' fill='#1D1631'>13–15 mil €</text><rect x='0' y='118' width='22' height='16' rx='3' fill='#8A5A00' stroke='#FFFFFF'/><text x='30' y='131' font-family='Segoe UI' font-size='13' fill='#1D1631'>15–18 mil €</text><rect x='0' y='140' width='22' height='16' rx='3' fill='#5C3B00' stroke='#FFFFFF'/><text x='30' y='153' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 18.000 €</text>", 2, "<text x='0' y='16' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Densidad (hab./km²)</text><rect x='0' y='30' width='22' height='16' rx='3' fill='#F3EFF9' stroke='#FFFFFF'/><text x='30' y='43' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 1.000</text><rect x='0' y='52' width='22' height='16' rx='3' fill='#D9CDEE' stroke='#FFFFFF'/><text x='30' y='65' font-family='Segoe UI' font-size='13' fill='#1D1631'>1–5 mil</text><rect x='0' y='74' width='22' height='16' rx='3' fill='#B19DDA' stroke='#FFFFFF'/><text x='30' y='87' font-family='Segoe UI' font-size='13' fill='#1D1631'>5–10 mil</text><rect x='0' y='96' width='22' height='16' rx='3' fill='#8467BD' stroke='#FFFFFF'/><text x='30' y='109' font-family='Segoe UI' font-size='13' fill='#1D1631'>10–20 mil</text><rect x='0' y='118' width='22' height='16' rx='3' fill='#5B3F99' stroke='#FFFFFF'/><text x='30' y='131' font-family='Segoe UI' font-size='13' fill='#1D1631'>20–30 mil</text><rect x='0' y='140' width='22' height='16' rx='3' fill='#2E1B5E' stroke='#FFFFFF'/><text x='30' y='153' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 30 mil</text>", 3, "<text x='0' y='16' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Población de 65 y más años</text><rect x='0' y='30' width='22' height='16' rx='3' fill='#EAF4F2' stroke='#FFFFFF'/><text x='30' y='43' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 12 %</text><rect x='0' y='52' width='22' height='16' rx='3' fill='#BFE0DA' stroke='#FFFFFF'/><text x='30' y='65' font-family='Segoe UI' font-size='13' fill='#1D1631'>12–16 %</text><rect x='0' y='74' width='22' height='16' rx='3' fill='#7CC2B6' stroke='#FFFFFF'/><text x='30' y='87' font-family='Segoe UI' font-size='13' fill='#1D1631'>16–20 %</text><rect x='0' y='96' width='22' height='16' rx='3' fill='#2E9C8F' stroke='#FFFFFF'/><text x='30' y='109' font-family='Segoe UI' font-size='13' fill='#1D1631'>20–24 %</text><rect x='0' y='118' width='22' height='16' rx='3' fill='#1F6E66' stroke='#FFFFFF'/><text x='30' y='131' font-family='Segoe UI' font-size='13' fill='#1D1631'>24–28 %</text><rect x='0' y='140' width='22' height='16' rx='3' fill='#0E3F3A' stroke='#FFFFFF'/><text x='30' y='153' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 28 %</text>", 4, "<text x='0' y='16' font-family='Segoe UI' font-size='15' font-weight='700' fill='#1D1631'>Población de la sección</text><rect x='0' y='30' width='22' height='16' rx='3' fill='#F3EFF9' stroke='#FFFFFF'/><text x='30' y='43' font-family='Segoe UI' font-size='13' fill='#1D1631'>&lt; 800</text><rect x='0' y='52' width='22' height='16' rx='3' fill='#D9CDEE' stroke='#FFFFFF'/><text x='30' y='65' font-family='Segoe UI' font-size='13' fill='#1D1631'>800–1.100</text><rect x='0' y='74' width='22' height='16' rx='3' fill='#B19DDA' stroke='#FFFFFF'/><text x='30' y='87' font-family='Segoe UI' font-size='13' fill='#1D1631'>1.100–1.400</text><rect x='0' y='96' width='22' height='16' rx='3' fill='#8467BD' stroke='#FFFFFF'/><text x='30' y='109' font-family='Segoe UI' font-size='13' fill='#1D1631'>1.400–1.700</text><rect x='0' y='118' width='22' height='16' rx='3' fill='#5B3F99' stroke='#FFFFFF'/><text x='30' y='131' font-family='Segoe UI' font-size='13' fill='#1D1631'>1.700–2.100</text><rect x='0' y='140' width='22' height='16' rx='3' fill='#2E1B5E' stroke='#FFFFFF'/><text x='30' y='153' font-family='Segoe UI' font-size='13' fill='#1D1631'>&gt; 2.100</text>") & "</g>"
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & MAX(ancho, 320) & " " & (alto + 175) & "'>"
			    & "<g stroke='#FFFFFF' stroke-width='0.6' stroke-linejoin='round'>" & grupos & "</g>"
			    & "<g fill='none' stroke='#1D1631' stroke-width='2.2' stroke-linejoin='round'>" & dist & "</g>"
			    & IF(COUNTROWS(dt) > 1, etiq, "") & leyenda & "</svg>"
			RETURN IF(ISBLANK(m) || ISBLANK(ancho), BLANK(),
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23"))
		displayFolder: Formato
		lineageTag: 5c737a76-59ba-4193-abbe-f90a945bcdcb
		dataCategory: ImageUrl

	measure 'Territorio electoral' =
			IF(HASONEVALUE(CCAA[ccaa_ine]) && (ISFILTERED(CCAA[nombre]) || ISFILTERED(CCAA[ccaa_ine])),
			   "ES-CA-" & SELECTEDVALUE(CCAA[ccaa_ine]), "ES")
		displayFolder: Formato
		lineageTag: a4f8d654-42c3-4cfd-b05d-aced449c7c3c

	measure 'Votos (nac)' = VAR g = [Territorio electoral] RETURN CALCULATE(SUM('Resultados familia'[votos]), 'Resultados familia'[geo_id] = g, REMOVEFILTERS(CCAA))
		formatString: #,0
		displayFolder: Elecciones
		lineageTag: 5ffe0dd2-a541-4842-b166-3bffae3c9caf

	measure 'Escaños (nac)' = VAR g = [Territorio electoral] RETURN CALCULATE(SUM('Resultados familia'[escanos]), 'Resultados familia'[geo_id] = g, REMOVEFILTERS(CCAA))
		formatString: 0
		displayFolder: Elecciones
		lineageTag: 85311f26-ceef-4897-86fd-ee9872f4968a

	measure '% voto (nac)' = DIVIDE([Votos (nac)], CALCULATE([Votos (nac)], REMOVEFILTERS('Resultados familia'[familia])))
		formatString: 0.0%
		displayFolder: Elecciones
		lineageTag: 584c70cf-7154-43da-8982-939ed70c5582

	measure 'Participación (nac)' =
			VAR g = [Territorio electoral]
			RETURN CALCULATE(DIVIDE(SUM('Participación nacional'[votantes]), SUM('Participación nacional'[censo])),
			                 'Participación nacional'[geo_id] = g, REMOVEFILTERS(CCAA))
		formatString: 0.0%
		displayFolder: Elecciones
		lineageTag: 4ce07833-cac4-4c06-ba85-87135f9306c8

	measure 'Votantes (nac)' = VAR g = [Territorio electoral] RETURN CALCULATE(SUM('Participación nacional'[votantes]), 'Participación nacional'[geo_id] = g, REMOVEFILTERS(CCAA))
		formatString: #,0
		displayFolder: Elecciones
