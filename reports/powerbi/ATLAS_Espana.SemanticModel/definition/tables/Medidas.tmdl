	measure 'Gallagher (nac)' = VAR g = [Territorio electoral] RETURN CALCULATE(AVERAGE('Índices electorales'[gallagher]), 'Índices electorales'[geo_id] = g, REMOVEFILTERS(CCAA))
		formatString: 0.00
		displayFolder: Elecciones
		lineageTag: 7e78885e-943f-44e3-8515-ab1c27b49dd9

	measure 'Volatilidad (nac)' = VAR g = [Territorio electoral] RETURN CALCULATE(AVERAGE('Índices electorales'[volatilidad_pedersen]), 'Índices electorales'[geo_id] = g, REMOVEFILTERS(CCAA))
		formatString: 0.0%
