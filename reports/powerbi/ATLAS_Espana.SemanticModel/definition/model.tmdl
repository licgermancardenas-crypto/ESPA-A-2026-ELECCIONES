model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-ES
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["CarpetaDatos", "CCAA", "Provincias", "Municipios", "Secciones", "Distritos ciudad", "Elecciones regionales", "Participación regional", "Convocatorias", "Convocatorias nacionales", "Resultados familia", "Participación nacional", "Ganador municipio", "Ganador provincia", "Índices electorales", "Serie población", "PIB provincia", "Paro", "Fuentes", "Ejecuciones", "Calidad", "Métrica del mapa", "Fondo satélite", "Mapa base", "Nivel del mapa", "Métrica ciudad", "Medidas"]

ref table CCAA
ref table Provincias
ref table Municipios
ref table Secciones
ref table 'Distritos ciudad'
ref table 'Elecciones regionales'
ref table 'Participación regional'
ref table Convocatorias
ref table 'Convocatorias nacionales'
ref table 'Resultados familia'
ref table 'Participación nacional'
ref table 'Ganador municipio'
ref table 'Ganador provincia'
ref table 'Índices electorales'
ref table 'Serie población'
ref table 'PIB provincia'
ref table Paro
ref table Fuentes
ref table Ejecuciones
ref table Calidad
ref table 'Métrica del mapa'
ref table 'Fondo satélite'
ref table 'Mapa base'
ref table 'Nivel del mapa'
ref table 'Métrica ciudad'
ref table Medidas
